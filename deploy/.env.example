# ============================================================
#  chunk-english · 环境变量模板
#  复制为 .env 后逐项填写；.env 不要提交到 Git
#  cp .env.example .env
# ============================================================

# ---------- 应用 ----------
NODE_ENV=production
APP_PORT=3000
IMAGE_TAG=latest
NEXTAUTH_URL=https://chunk.rubyc.cn
# 生成：openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# ---------- 数据库（PostgreSQL）----------
# 主机名用 1Panel 里的容器名（如 1Panel-postgresql-Htbt）或 host.docker.internal
DATABASE_URL=postgresql://chunk_user:CHANGE_ME@host.docker.internal:5432/chunk_english?schema=public

# ---------- MinIO（独立容器）----------
# ⚠️ 9000 是 S3 API 端口，不是 9001 控制台
S3_ENDPOINT=http://host.docker.internal:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=chunk-public
S3_BUCKET_PRIVATE=chunk-private
# 浏览器可达的公开前缀（预签名 URL 的 host 会被替换成它）
S3_PUBLIC_BASE=https://media.chunk.rubyc.cn/chunk-public
# 预签名有效期（秒）
SIGN_GET_TTL=900
SIGN_PUT_TTL=600
MAX_SHADOW_BYTES=8388608

# ---------- 业务规则 ----------
FREE_EPISODE_LIMIT=5
FREE_SHADOW_QUOTA_PER_EP=3

# ---------- 邮件（邮箱验证 / 找回密码）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="苑说英语 <no-reply@chunk.rubyc.cn>"

# ---------- 初始管理员（seed 用，首次登录后立刻改密码）----------
SEED_ADMIN_EMAIL=admin@rubyc.cn
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG
SEED_ADMIN_NICKNAME=站长

# ---------- 内容导入脚本 ----------
VIDEO_ROOT=/data/video-workspace
IMPORT_DATABASE_URL=postgresql://chunk_user:CHANGE_ME@127.0.0.1:5432/chunk_english
